{
  "defaults": {
    "normal_model": "gpt-5.6-luna",
    "normal_effort": "medium",
    "critical_model": "gpt-5.6-terra",
    "critical_effort": "high",
    "aggregator_model": "gpt-5.6-terra",
    "aggregator_effort": "high"
  },
  "rules": [
    {
      "name": "clean-arch-guard",
      "model_kind": "normal",
      "path_prefixes": ["backend/"],
      "path_suffixes": [".py"],
      "role_references": ["backend-architecture.md"]
    },
    {
      "name": "migration-reviewer",
      "model_kind": "critical",
      "path_prefixes": ["backend/migrations/", "backend/migrations_control/"],
      "role_references": ["backend-architecture.md"]
    },
    {
      "name": "frontend-reviewer",
      "model_kind": "normal",
      "path_prefixes": ["frontend/"],
      "role_references": ["frontend-patterns.md"]
    },
    {
      "name": "user-advocate",
      "model_kind": "normal",
      "path_prefixes": ["frontend/src/app/", "frontend/src/components/"],
      "path_suffixes": [".tsx"],
      "role_references": ["page-archetypes.md", "frontend-patterns.md"]
    },
    {
      "name": "security-auditor",
      "model_kind": "critical",
      "path_prefixes": [".github/workflows/", "scripts/ci/"],
      "path_contains": ["secret", "auth", "token", "permission", "keycloak"],
      "role_references": ["security-patterns.md"]
    },
    {
      "name": "infra-reviewer",
      "model_kind": "normal",
      "path_prefixes": [
        ".github/workflows/",
        "scripts/ci/",
        "helm/",
        "db/",
        "keycloak/",
        "local-install/",
        ".devcontainer/",
        "ssl/"
      ],
      "path_names": ["Dockerfile", "Makefile"],
      "path_contains": ["docker-compose"],
      "role_references": ["infrastructure.md"]
    },
    {
      "name": "prompt-critic",
      "model_kind": "normal",
      "path_prefixes": [
        ".cursor/agents/",
        ".cursor/rules/",
        ".cursor/skills/",
        ".agents/",
        ".github/codex/",
        "backend/src/backend/evaluation/",
        "backend/tests/evaluators/"
      ],
      "path_names": ["AGENTS.md"],
      "path_contains": ["/prompts/", "/assertions/"],
      "role_references": ["llm-prompts.md"]
    }
  ]
}
