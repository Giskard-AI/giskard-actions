{
  "$schema": "https://raw.githubusercontent.com/Giskard-AI/giskard-actions/main/schemas/codex-reviewer-map.schema.json",
  "defaults": {
    "normal_model": "gpt-5.6-luna",
    "normal_effort": "medium",
    "critical_model": "gpt-5.6-terra",
    "critical_effort": "high",
    "aggregator_model": "gpt-5.6-terra",
    "aggregator_effort": "high"
  },
  "rules": [
    {
      "name": "backend-reviewer",
      "model_kind": "normal",
      "path_prefixes": ["backend/"],
      "path_suffixes": [".py"],
      "role_references": ["backend-architecture.md"]
    },
    {
      "name": "migration-reviewer",
      "model_kind": "critical",
      "path_prefixes": ["backend/migrations/"],
      "role_references": ["backend-architecture.md"]
    },
    {
      "name": "frontend-reviewer",
      "model_kind": "normal",
      "path_prefixes": ["frontend/"],
      "role_references": ["frontend-patterns.md"]
    },
    {
      "name": "security-auditor",
      "model_kind": "critical",
      "path_prefixes": [".github/workflows/", "scripts/ci/"],
      "path_contains": ["secret", "auth", "token", "permission"],
      "role_references": ["security-patterns.md"]
    },
    {
      "name": "infra-reviewer",
      "model_kind": "normal",
      "path_prefixes": [".github/workflows/", "scripts/ci/", "deploy/"],
      "path_names": ["Dockerfile", "Makefile"],
      "path_contains": ["docker-compose"],
      "role_references": ["infrastructure.md"]
    },
    {
      "name": "prompt-critic",
      "model_kind": "normal",
      "path_prefixes": [".cursor/agents/", ".cursor/rules/", ".cursor/skills/"],
      "path_names": ["AGENTS.md"],
      "path_contains": ["/prompts/"],
      "role_references": ["llm-prompts.md"]
    }
  ]
}
