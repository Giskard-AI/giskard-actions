{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["before 4am on Monday"],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    ":pinAllExceptPeerDependencies"
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621", "pyenv"],
      "description": "Disable python versions from updating",
      "enabled": false,
      "matchPackageNames": ["/^python$/"]
    },
    {
      "groupName": "{{manager}} dependencies",
      "groupSlug": "{{manager}}-deps",
      "matchUpdateTypes": ["*"],
      "matchPackageNames": ["*"]
    },
    {
      "description": "Group pep621 Python updates into one PR.",
      "matchManagers": ["pep621"],
      "groupName": "python deps",
      "groupSlug": "python-deps"
    },
    {
      "description": "GHCR gives zizmor images no release timestamp, which minimumReleaseAge needs; read zizmor releases from PyPI instead.",
      "matchPackageNames": ["ghcr.io/zizmorcore/zizmor"],
      "overrideDatasource": "pypi",
      "overridePackageName": "zizmor"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Default Codex CLI version of the Codex review action, reusable workflow, and docs.",
      "managerFilePatterns": [
        "/^\\.github/actions/codex-pr-review/action\\.yml$/",
        "/^\\.github/workflows/codex-pr-review\\.yml$/",
        "/^docs/codex-pr-review\\.md$/"
      ],
      "matchStrings": [
        "codex_version:\\n(?:\\s+(?:description|type|required): .*\\n)+\\s+default: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "\\| `codex_version` \\| string \\| `(?<currentValue>\\d+\\.\\d+\\.\\d+)` \\|"
      ],
      "depNameTemplate": "@openai/codex",
      "datasourceTemplate": "npm"
    }
  ]
}
