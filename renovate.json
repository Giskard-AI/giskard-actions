{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["before 4am on Monday"],
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    ":pinAllExceptPeerDependencies"
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621", "pyenv"],
      "description": "Disable python versions from updating",
      "enabled": false,
      "matchPackageNames": ["/^python$/"]
    },
    {
      "groupName": "{{manager}} dependencies",
      "groupSlug": "{{manager}}-deps",
      "matchUpdateTypes": ["*"],
      "matchPackageNames": ["*"]
    },
    {
      "description": "Group pep621 Python updates and flag them for the in-PR lockfile refresh workflow.",
      "matchManagers": ["pep621"],
      "groupName": "python deps",
      "groupSlug": "python-deps",
      "labels": ["dependencies", "deps:lockfile=python"]
    }
  ]
}
