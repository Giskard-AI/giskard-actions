{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["before 4am on Monday"],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    ":pinAllExceptPeerDependencies"
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621", "pyenv"],
      "description": "Disable python versions from updating",
      "enabled": false,
      "matchPackageNames": ["/^python$/"]
    },
    {
      "groupName": "{{manager}} dependencies",
      "groupSlug": "{{manager}}-deps",
      "matchUpdateTypes": ["*"],
      "matchPackageNames": ["*"]
    },
    {
      "description": "Group pep621 Python updates into one PR.",
      "matchManagers": ["pep621"],
      "groupName": "python deps",
      "groupSlug": "python-deps"
    },
    {
      "description": "GHCR gives zizmor images no release timestamp, so minimumReleaseAge cannot apply: wait for Dependency Dashboard approval, given once the PyPI release of the same version is 7 days old.",
      "matchPackageNames": ["ghcr.io/zizmorcore/zizmor"],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Default Codex CLI version of the Codex review action, reusable workflow, and docs.",
      "managerFilePatterns": [
        "/^\\.github/actions/codex-review-pass/action\\.yml$/",
        "/^\\.github/workflows/codex-pr-review\\.yml$/",
        "/^docs/codex-pr-review\\.md$/"
      ],
      "matchStrings": [
        "codex_version:\\n(?:\\s+(?:description|type|required): .*\\n)+\\s+default: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "\\| `codex_version` \\| string \\| `(?<currentValue>\\d+\\.\\d+\\.\\d+)` \\|"
      ],
      "depNameTemplate": "@openai/codex",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "zizmor image (version and digest) run by the Gate scan script and this repository's own zizmor workflow.",
      "managerFilePatterns": ["/^\\.github/workflows/zizmor\\.yml$/", "/^scripts/zizmor/scan\\.sh$/"],
      "matchStrings": [
        "ZIZMOR_IMAGE(?:: |=\")(?<depName>ghcr\\.io/zizmorcore/zizmor):(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
