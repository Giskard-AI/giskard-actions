{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Giskard-AI/giskard-actions/main/schemas/codex-reviewer-map.schema.json",
  "title": "Codex reviewer map",
  "description": "Maps changed paths to Codex reviewer passes. Read from .github/giskard/codex-reviewer-map.json at the pull request base SHA.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editor support."
    },
    "defaults": {
      "$ref": "#/$defs/modelDefaults",
      "description": "Model and effort defaults. Workflow inputs override these; these override the built-in defaults."
    },
    "models": {
      "$ref": "#/$defs/modelDefaults",
      "description": "Alias of defaults, read only when defaults is absent."
    },
    "normal_model": { "$ref": "#/$defs/nonEmptyString" },
    "normal_effort": { "$ref": "#/$defs/nonEmptyString" },
    "critical_model": { "$ref": "#/$defs/nonEmptyString" },
    "critical_effort": { "$ref": "#/$defs/nonEmptyString" },
    "aggregator_model": { "$ref": "#/$defs/nonEmptyString" },
    "aggregator_effort": { "$ref": "#/$defs/nonEmptyString" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "description": "Reviewer rules. Each rule selects a reviewer when any changed path matches it. At most 12 reviewers run per pull request.",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modelDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normal_model": { "$ref": "#/$defs/nonEmptyString" },
        "normal_effort": { "$ref": "#/$defs/nonEmptyString" },
        "critical_model": { "$ref": "#/$defs/nonEmptyString" },
        "critical_effort": { "$ref": "#/$defs/nonEmptyString" },
        "aggregator_model": { "$ref": "#/$defs/nonEmptyString" },
        "aggregator_effort": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Reviewer name. The persona is loaded from .cursor/agents/<name>.md at the base SHA, falling back to a bundled generic persona for security-auditor, infra-reviewer and prompt-critic."
        },
        "model_kind": {
          "enum": ["normal", "critical"],
          "default": "normal",
          "description": "Selects the normal or critical model and effort defaults."
        },
        "model": {
          "type": "string",
          "description": "Per-rule model override."
        },
        "effort": {
          "type": "string",
          "description": "Per-rule reasoning effort override."
        },
        "path_prefixes": {
          "$ref": "#/$defs/stringList",
          "description": "Matches paths under these prefixes. Combined with path_suffixes, both must match."
        },
        "path_suffixes": {
          "$ref": "#/$defs/stringList",
          "description": "Matches paths ending with these suffixes. Combined with path_prefixes, both must match."
        },
        "path_names": {
          "$ref": "#/$defs/stringList",
          "description": "Matches exact paths or basenames."
        },
        "path_contains": {
          "$ref": "#/$defs/stringList",
          "description": "Matches paths containing these fragments (case-insensitive)."
        },
        "role_references": {
          "type": "array",
          "description": "Basenames of files under .cursor/agents/references/ staged for this reviewer.",
          "items": {
            "type": "string",
            "pattern": "^[^/\\\\]+$",
            "not": { "pattern": "\\.\\." }
          }
        }
      }
    }
  }
}
